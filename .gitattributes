# Trim CI/internal noise from `git archive` output (GitHub Release source
# archives). Use the `/**` form: a bare `dir/` pattern does not recurse
# reliably for export-ignore. Refs cinatra-ai/cinatra-engineering#56.
.github/** export-ignore
tests/** export-ignore
.gitattributes export-ignore
.gitignore export-ignore

# Tests and test tooling.
src/__tests__ export-ignore
src/__tests__/** export-ignore
vitest.config.ts export-ignore
